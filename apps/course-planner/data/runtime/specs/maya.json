{
  "versions": [
    {
      "id": "spec-maya",
      "version": 1,
      "userId": "maya",
      "parent": "default@1",
      "profile": "A typical university user browsing the Spring 2027 schedule. No known preferences, constraints or role-specific workflows.",
      "home": "catalog",
      "views": [
        {
          "id": "catalog",
          "title": "Course catalog",
          "purpose": "Find, search, filter or browse the courses and sections offered this term, and read one course's details.",
          "layout": "main-aside",
          "slots": [
            {
              "id": "notice",
              "component": "deadline-banner",
              "region": "top",
              "props": {},
              "adaptive": [
                "tone"
              ]
            },
            {
              "id": "results",
              "component": "course-search",
              "region": "main",
              "props": {},
              "adaptive": [
                "timeFilter",
                "seats",
                "scope",
                "ranking"
              ]
            },
            {
              "id": "detail",
              "component": "course-detail",
              "region": "aside",
              "props": {},
              "adaptive": [
                "emphasis"
              ]
            }
          ]
        },
        {
          "id": "schedule",
          "title": "My schedule",
          "purpose": "See the week of planned classes, check for time conflicts, and review or submit the enrollment plan.",
          "layout": "main-aside",
          "slots": [
            {
              "id": "week",
              "component": "week-calendar",
              "region": "main",
              "props": {},
              "adaptive": [
                "primaryView"
              ]
            },
            {
              "id": "plan",
              "component": "plan-cart",
              "region": "aside",
              "props": {},
              "adaptive": []
            }
          ]
        },
        {
          "id": "progress",
          "title": "Degree progress",
          "purpose": "Check which degree requirements are complete, planned or remaining, and which courses to take next.",
          "layout": "main-aside",
          "slots": [
            {
              "id": "numbers",
              "component": "stat-strip",
              "region": "top",
              "props": {
                "focus": "progress"
              },
              "adaptive": []
            },
            {
              "id": "requirements",
              "component": "degree-progress",
              "region": "main",
              "props": {},
              "adaptive": [
                "presentation",
                "detail"
              ]
            }
          ]
        },
        {
          "id": "demand",
          "title": "Seat availability",
          "purpose": "See which courses are full or waitlisted and how demand compares with capacity.",
          "layout": "stack",
          "slots": [
            {
              "id": "chart",
              "component": "demand-chart",
              "region": "main",
              "props": {},
              "adaptive": [
                "measure",
                "scope"
              ]
            }
          ]
        },
        {
          "id": "field-time",
          "title": "Courses by field and time",
          "purpose": "List courses filtered by field (STEM or non-STEM) together with start time (such as after 12pm, morning or evening) and, when asked, only open sections, e.g. open STEM courses after noon.",
          "layout": "main-aside",
          "slots": [
            {
              "id": "finder",
              "component": "course-field-time-finder",
              "region": "main",
              "props": {},
              "adaptive": [
                "field",
                "startTime",
                "seats"
              ]
            },
            {
              "id": "detail",
              "component": "course-detail",
              "region": "aside",
              "props": {
                "emphasis": "sections"
              },
              "adaptive": []
            }
          ]
        }
      ],
      "rationale": [
        "The shared default: a catalog with detail, a schedule, degree progress and seat availability. It serves most students without personalization."
      ],
      "changelog": [
        {
          "version": 1,
          "at": "2026-09-26T23:46:56.586Z",
          "by": "claude-extend",
          "summary": "Added a view for Maya Chen that filters courses by STEM field, start time and open seats together, using the existing course-field-time-finder component."
        }
      ]
    },
