{
  "versions": [
    {
      "id": "spec-okafor",
      "version": 1,
      "userId": "okafor",
      "parent": "default@1",
      "profile": "A typical university user browsing the Spring 2027 schedule. No known preferences, constraints or role-specific workflows.",
      "home": "catalog",
      "views": [
        {
          "id": "catalog",
          "title": "Course catalog",
          "purpose": "Find, search, filter or browse the courses and sections offered this term, and read one course's details.",
          "layout": "main-aside",
          "slots": [
            {
              "id": "notice",
              "component": "deadline-banner",
              "region": "top",
              "props": {},
              "adaptive": [
                "tone"
              ]
            },
            {
              "id": "results",
              "component": "course-search",
              "region": "main",
              "props": {},
              "adaptive": [
                "timeFilter",
                "scope",
                "ranking"
              ]
            },
            {
              "id": "detail",
              "component": "course-detail",
              "region": "aside",
              "props": {},
              "adaptive": [
                "emphasis"
              ]
            }
          ]
        },
        {
          "id": "demand",
          "title": "Seat availability",
          "purpose": "See which courses are full or waitlisted and how demand compares with capacity.",
          "layout": "stack",
          "slots": [
            {
              "id": "chart",
              "component": "demand-chart",
              "region": "main",
              "props": {},
              "adaptive": [
                "measure",
                "scope"
              ]
            }
          ]
        },
        {
          "id": "advisee-week",
          "title": "Advisee class times",
          "purpose": "See a heatmap of when advisees' planned classes meet across the weekdays and hours, find the busiest and freest times, and list which advisees are in class at a given time.",
          "layout": "main-aside",
          "slots": [
            {
              "id": "heatmap",
              "component": "advisee-meeting-heatmap",
              "region": "main",
              "props": {
                "annotation": "counts"
              },
              "adaptive": [
                "scope",
                "binSize"
              ]
            },
            {
              "id": "advisee",
              "component": "advisee-detail",
              "region": "aside",
              "props": {
                "emphasis": "plan"
              },
              "adaptive": []
            }
          ]
        }
      ],
      "rationale": [
        "The shared default: a catalog with detail, a schedule, degree progress and seat availability. It serves most students without personalization."
      ],
      "changelog": [
        {
          "version": 1,
          "at": "2026-09-26T21:31:28.392Z",
          "by": "claude-extend",
          "summary": "Added an advisee class-time heatmap view for Dr. Okafor showing when advisees' planned classes meet across the week."
        }
      ]
    },
