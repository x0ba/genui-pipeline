{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictFunctionTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "paths": { "@kit": ["./apps/course-planner/web/src/kit/index.ts"] }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/course-planner/shared",
    "apps/course-planner/server",
    "apps/course-planner/web/src",
    "apps/course-planner/scripts",
    "apps/course-planner/vite.config.ts"
  ]
}
